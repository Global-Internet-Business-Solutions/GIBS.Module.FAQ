@using GIBS.Module.FAQ.Services
@using GIBS.Module.FAQ.Models

@namespace GIBS.Module.FAQ
@inherits ModuleBase
@inject IFAQService ClientFAQService
@inject ICategoryService ClientCategoryService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

@if (_FAQs == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="text-end">
        <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Manage FAQ" ResourceKey="ManageFAQ" />
        <ActionLink Action="ManageCategory" Security="SecurityAccessLevel.Edit" Text="Manage Categories" ResourceKey="ManageCategory" />
    </div>

    @if (_allFAQs.Count != 0)
    {
        <section class="py-4 bg-light rounded-3 mt-3">
            <div class="container">
                <div class="row justify-content-center mb-4">
                    <div class="col-lg-10 text-center">
                        <h2 class="mb-2">@Localizer["Frequently Asked Questions"]</h2>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-10 text-center mb-3">
                        <a class="btn btn-outline-secondary btn-sm me-2 mb-2 @(string.IsNullOrEmpty(_selectedCategorySlug) ? "active" : "")" href="@NavigateUrl()">All</a>
                       
                        @foreach (var category in _categories)
                        {
                            <a class="btn btn-outline-secondary btn-sm me-2 mb-2 @(_selectedCategorySlug == category.Slug ? "active" : "")" href="@NavigateUrl()?Category=@Uri.EscapeDataString(category.Slug)">@category.Name</a>
                        }
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        @foreach (var categoryGroup in _FAQs.GroupBy(faq => new
                        {
                            faq.CategoryId,
                            CategoryName = string.IsNullOrWhiteSpace(faq.CategoryName) ? "Uncategorized" : faq.CategoryName
                        }))
                        {
                            var accordionId = $"faqAccordion{categoryGroup.Key.CategoryId}";
                            <h3 class="h3 mt-4 mb-3">
                                <span class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle border border-dark" style="width: 44px; height: 44px;">
                                    <i class="oi oi-question-mark"></i></span> &nbsp;
                                @categoryGroup.Key.CategoryName
                            
                            </h3>
                            <div class="accordion mb-4" id="@accordionId">
                                @foreach (var faq in categoryGroup)
                                {
                                    var headingId = $"faqHeading{faq.FAQId}";
                                    var collapseId = $"faqCollapse{faq.FAQId}";
                                    <div class="accordion-item mb-4">
                                        <h2 class="accordion-header" id="@headingId">
                                            <a class="fs-4 accordion-button @(_expandedFAQId == faq.FAQId ? "" : "collapsed")" href="@GetFaqUrl(faq.FAQId)" aria-expanded="@(_expandedFAQId == faq.FAQId ? "true" : "false")" aria-controls="@collapseId">
                                                @faq.Question
                                            </a>
                                        </h2>
                                        <div id="@collapseId" class="accordion-collapse collapse @(_expandedFAQId == faq.FAQId ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#@accordionId">
                                            <div class="accordion-body">
                                                @if (string.IsNullOrWhiteSpace(faq.Answer))
                                                {
                                                    <span class="text-muted">No answer provided.</span>
                                                }
                                                else
                                                {
                                                    @((MarkupString)@faq.Answer) 
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <p class="mt-3">@Localizer["Message.DisplayNone"]</p>
    }
}

@code {
    public override string RenderMode => RenderModes.Static;

    List<FAQ> _allFAQs = new();
    List<FAQ> _FAQs;
    List<Category> _categories = new();
    string _selectedCategorySlug;
    int? _expandedFAQId;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Resource { ResourceType = ResourceType.Stylesheet, Url = "_content/GIBS.Module.FAQ/css/default.css?v=1.0.6" }

    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await ClientCategoryService.GetCategoriesAsync(ModuleState.ModuleId);
            var faqs = await ClientFAQService.GetFAQsAsync(ModuleState.ModuleId);
            _allFAQs = faqs
                .Where(f => string.Equals(f.Status, "published", StringComparison.OrdinalIgnoreCase))
                .OrderBy(f => f.CategorySortOrder)
                .ThenBy(f => f.SortOrder)
                .ThenBy(f => f.Question, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (!PageState.QueryString.TryGetValue("Category", out _selectedCategorySlug))
            {
                PageState.QueryString.TryGetValue("category", out _selectedCategorySlug);
                //SetPageTitle(_categories.FirstOrDefault(c => string.Equals(c.Slug, _selectedCategorySlug, StringComparison.OrdinalIgnoreCase))?.Name);
            }

            ApplyFilter();

            string faqValue;
            if (!PageState.QueryString.TryGetValue("faq", out faqValue))
            {
                if (!PageState.QueryString.TryGetValue("FAQ", out faqValue))
                {
                    if (!PageState.QueryString.TryGetValue("question", out faqValue))
                    {
                        PageState.QueryString.TryGetValue("Question", out faqValue);
                    }
                }
            }

            if (int.TryParse(faqValue, out var faqId) && _FAQs.Any(x => x.FAQId == faqId))
            {
                _expandedFAQId = faqId;
                await ClientFAQService.IncrementViewCountAsync(faqId, ModuleState.ModuleId);

                var faq = _allFAQs.FirstOrDefault(x => x.FAQId == faqId);
                if (faq != null)
                {
                    faq.ViewCount++;
                    SetPageTitle(faq.Question);
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading FAQ {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_selectedCategorySlug))
        {
            _FAQs = _allFAQs;
            return;
        }

        var category = _categories.FirstOrDefault(c => string.Equals(c.Slug, _selectedCategorySlug, StringComparison.OrdinalIgnoreCase));
        _FAQs = (category == null)
            ? new List<FAQ>()
            : _allFAQs.Where(x => x.CategoryId == category.CategoryId).ToList();
        SetPageTitle($"{category?.Name} FAQs");
    }

    private string GetFaqUrl(int faqId)
    {
        var url = NavigateUrl();
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(_selectedCategorySlug))
        {
            query.Add($"Category={Uri.EscapeDataString(_selectedCategorySlug)}");
        }

        if (_expandedFAQId != faqId)
        {
            query.Add($"faq={faqId}");
        }

        return query.Count == 0
            ? url
            : $"{url}?{string.Join("&", query)}";
    }
}