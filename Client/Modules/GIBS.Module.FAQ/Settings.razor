@namespace GIBS.Module.FAQ
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@inject IStringLocalizer<Settings> Localizer

<div class="container">
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="introText" HelpText="Enter a value for IntroText" ResourceKey="IntroText" ResourceType="@resourceType">Intro Text: </Label>
            <div class="col-sm-9">
            <textarea id="introText" name="introText" rows="4" cols="50" placeholder="Type here..." @bind="@_introText"></textarea>
            </div>
    </div>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="enableAskQuestion" HelpText="Allow users to submit questions via the Ask a Question form" ResourceKey="EnableAskQuestion" ResourceType="@resourceType">Enable Ask a Question: </Label>
        <div class="col-sm-9">
            <input id="enableAskQuestion" type="checkbox" @bind="@_enableAskQuestion" />
        </div>
    </div>
</div>

@code {
    private string resourceType = "GIBS.Module.FAQ.Settings, GIBS.Module.FAQ.Client.Oqtane"; // for localization
    public override string Title => "FAQ Settings";

    private string _introText;
    private bool _enableAskQuestion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Dictionary<string, string> settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _introText = SettingService.GetSetting(settings, "IntroText", "");
            _enableAskQuestion = bool.Parse(SettingService.GetSetting(settings, "EnableAskQuestion", "true"));
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            settings = SettingService.SetSetting(settings, "IntroText", _introText);
            settings = SettingService.SetSetting(settings, "EnableAskQuestion", _enableAskQuestion.ToString());
            await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }
}
